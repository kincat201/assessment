<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
	
	
        <handlers>
            <add name="FastCGIPHP" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\Program Files (x86)\PHP\v7.1\php-cgi.exe" resourceType="File" requireAccess="Script" />
        </handlers>
        <directoryBrowse enabled="true" />
    </system.webServer>
</configuration>
